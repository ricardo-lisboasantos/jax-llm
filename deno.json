{
  "name": "@ricardo/jax-llm",
  "version": "0.2.3",
  "description": "A JAX-based LLM engine for JavaScript/TypeScript",
  "keywords": ["jax", "llm", "ai", "machine-learning"],
  "exports": "./mod.ts",
  "publish": {
    "include": ["mod.ts", "engine", "README.md", "LICENSE"],
    "exclude": ["**/*_test.ts", "cli", "docs"]
  },
  "license": "MIT",
  "tasks": {
    "dev": "deno test --watch",
    "compile": "deno compile -o dist/ja-js-llm -A main.ts",
    "fmt": "deno fmt --ext ts,tsx,js,jsx,json --check && deno fmt --ext ts,tsx,js,jsx,json",
    "lint": "deno lint",
    "prepare": "deno fmt && deno lint && deno test --filter unit",
    "test": "deno test --unstable-kv --allow-read --allow-write --allow-env --allow-net",
    "test:unit": "deno test --unstable-kv --allow-read --allow-write --allow-env --allow-net --filter unit",
    "test:integration": "deno test --unstable-kv --allow-read --allow-write --allow-env --allow-net --filter integration",
    "test:coverage": "deno test --coverage=cov_profile && deno coverage cov_profile --lcov > cov_profile.lcov",
    "test:coverage:upload": "deno coverage cov_profile --lcov | bash <(curl -s https://codecov.io/bash)",
    "typecheck": "deno run https://deno.land/std@0.224.0/tsc.ts --no-error-on-deprecated",
    "build": "deno bundle --no-export-maps main.ts dist/bundle.js",
    "start": "deno run -A main.ts",
    "bench": "deno test --unstable-kv --unstable-webgpu --allow-read --allow-write --allow-env --allow-net --filter bench"
  },
  "imports": {
    "@jax-js/jax": "npm:@jax-js/jax@^0.1.25",
    "@jax-js/loaders": "npm:@jax-js/loaders@^0.1.3",
    "@jax-js/onnx": "npm:@jax-js/onnx@^0.1.2",
    "@jax-js/optax": "npm:@jax-js/optax@^0.1.2",
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@^1.0.32"
  },
  "unstable": ["webgpu", "kv"],
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix", "no-unversioned-import"]
    }
  }
}
